+// Homepage feature is a single public setting guarded by admin-only RLS writes.
+// It is independent of the recipe importer and works with either national cuisine labels.
+async function loadHomepageHero(){
+ if(!isCloudConfigured||!getCloudClient())return;
+ try{
+   const {data,error}=await getCloudClient().from('eatable_site_settings')
+     .select('recipe_id').eq('setting_key','homepage_hero').maybeSingle();
+   if(error)throw error;
+   state.heroRecipeId=data?.recipe_id??null;
+   state.heroLoadError='';
+ }catch(e){
+   // Missing migration or temporary network trouble must never blank the site.
+   state.heroLoadError=e.message||String(e);
+   console.warn('Homepage photo setting unavailable:',e);
+ }
+ if(!active().length||active()[0]==='admin-hero')render();
